{
  "name": "serpent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "coverage-report": "tsx --conditions=react-server scripts/coverage-report.ts",
    "eval": "tsx --env-file-if-exists=.env --conditions=react-server scripts/eval.ts",
    "import-taxonomy": "tsx scripts/import-taxonomy.ts",
    "test:routes": "vitest run -c vitest.routes.config.ts",
    "i18n:review": "tsx scripts/review-list.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@fontsource-variable/noto-sans-myanmar": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@fontsource-variable/noto-serif-thai": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/noto-serif-myanmar": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "openai": "^7.30.0",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
