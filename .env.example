# Which vision provider analyzes photos: anthropic (default) or openai.
VISION_PROVIDER=anthropic

# Required when VISION_PROVIDER=anthropic. Server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=
# Optional: defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5

# Required when VISION_PROVIDER=openai. Server-side only, never exposed to the browser.
OPENAI_API_KEY=
# Optional: any vision-capable model; defaults to gpt-6.1-sol
OPENAI_MODEL=gpt-6.1-sol

# Optional: enables the anonymous analysis log (Neon Postgres URL)
DATABASE_URL=

# Optional: enables /admin/reports (misidentification reports). Use a long random value.
ADMIN_TOKEN=

# Optional: give uncertain identifications one more independent analysis (default true).
# Roughly doubles model cost for those photos.
VERIFY_UNCERTAIN=true
