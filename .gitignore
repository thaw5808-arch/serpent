# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# labelled evaluation photos and results (scripts/eval.ts)
/eval/

# downloaded third-party source data (scripts/import-taxonomy.ts)
/data-sources/

# explicit env coverage (.env* above already matches these)
.env
.env*.local
!.env.example

# scratch and backup folders
/scratchpad/
scratchpad/
*backup*/
*.bak
*.orig
